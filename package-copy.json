{
  "name": "ferryplaywright",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test:jenkins": "node --test configLayer/execution/commonJob/*.test.cjs",
    "test:unit": "playwright test -c automationLayer/insurance/unitTests/playwright.config.ts",
    "typecheck:unit": "tsc --noEmit -p automationLayer/insurance/unitTests/tsconfig.json",
    "typecheck:insurance": "tsc --noEmit -p automationLayer/insurance/tsconfig.json",
    "test:ferry:dev": "cross-env PROJECT=ferry ENV=dev AGENT_PORTAL_AUTH=skip playwright test",
    "test:ferry:test": "cross-env PROJECT=ferry ENV=test AGENT_PORTAL_AUTH=skip playwright test",
    "test:britannia:test": "cross-env PROJECT=britannia ENV=test AGENT_PORTAL_AUTH=skip playwright test",
    "test:britannia:uat": "cross-env PROJECT=britannia ENV=uat AGENT_PORTAL_AUTH=skip playwright test",
    "test:britannia:nft": "cross-env PROJECT=britannia ENV=nft AGENT_PORTAL_AUTH=skip playwright test",
    "test:allianzOnlineMotor:test": "cross-env PROJECT=allianzOnlineMotor ENV=test AGENT_PORTAL_AUTH=skip playwright test",
    "test:allianzOnlineHome:test": "cross-env PROJECT=allianzOnlineHome ENV=test AGENT_PORTAL_AUTH=skip playwright test",
    "docs:check": "node automationLayer/insurance/docs/checkDocs.js",
    "brands:allianz:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=allianz",
    "brands:britannia:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=britannia",
    "brands:audi:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=audi",
    "brands:cupra:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=cupra",
    "brands:seat:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=seat",
    "brands:skoda:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=skoda",
    "brands:vw:test": "cross-env ENV=test playwright test -c playwright.brands.config.ts --project=vw",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "deps:check": "depcruise automationLayer/insurance --config .dependency-cruiser.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.2.0",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "chance": "^1.1.13",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.36.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "exceljs": "^3.4.0",
    "googleapis": "^170.1.0",
    "imap-simple": "^1.6.3",
    "mailparser": "^3.9.1",
    "open": "^11.0.0",
    "treee": "^0.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
