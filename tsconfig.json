
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "@pages/*": [
        "./automationLayer/ferry/pages/*"
      ],
      "@shared/*": [
        "./automationLayer/insurance/shared/*"
      ],
      "@lv/*": [
        "./automationLayer/insurance/lv/*"
      ],
      "@ferry/*": [
        "./automationLayer/insurance/ferry/*"
      ],
      "@baseTest": [
        "./automationLayer/common/baseTest.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
