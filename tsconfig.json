{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": "./",
    "paths": {
      "@pages/*": ["automationLayer/ferry/pages/*"],
      "@shared/*": ["automationLayer/insurance/shared/*"],
      "@lv/*": ["automationLayer/insurance/lv/*"],
      "@ferry/*": ["automationLayer/insurance/ferry/*"]
    },
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.js"]
}
