{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "rootDir": "../..",
        "outDir": "../../dist",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true,
        "declaration": false,
        "sourceMap": true
    },
    "include": [
        "**/*.ts",
        "../../configLayer/brand.config.ts",
        "../../configLayer/channel.config.ts",
        "../../configLayer/product.config.ts",
        "../../configLayer/config.types.ts",
        "../../configLayer/config.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts",
        "**/*.spec.ts",
        "dist"
    ]
}